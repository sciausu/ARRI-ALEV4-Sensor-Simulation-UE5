// Common.ush (replaces the bare Platform.ush include) gives us access to the
// View uniform buffer, which we now bind from C++. We need it for
// View.PreExposure / View.OneOverPreExposure -- see notes at the pass entry.
#include "/Engine/Private/Common.ush"

Texture2D SceneColorTexture;
SamplerState SceneColorSampler;
float HighGainAmount;
float LowGainAmount;
float ShadowThreshold;
float HighlightThreshold;
float ExposureOffset;   // NEW: test-exposure offset in stops (r.ALEV4DGA.ExposureOffset)
float FullWell;         // NEW: simulated ADC full-scale in amplified units (r.ALEV4DGA.FullWell)
uint LogC4Enabled;
float2 ViewSize;
RWTexture2D<float4> OutputTexture;
uint DiagLuminance;

// -----------------------------------------------------------------------
// Rec.709 -> ARRI Wide Gamut 4 (AWG4) gamut transform matrix
// -----------------------------------------------------------------------
// Derived from official primary chromaticities:
//   AWG4 primaries: ARRI LogC4 Specification, Section 4.2.1
//     R: (0.7347, 0.2653)  G: (0.1424, 0.8576)  B: (0.0991, -0.0308)
//   Rec.709 primaries: ITU-R BT.709
//   Shared white point: CIE D65 (0.3127, 0.3290)
// Method: M_709->AWG4 = inv(M_AWG4->XYZ) * M_709->XYZ
// Both white points are D65, so no chromatic adaptation is required.
// White (1,1,1) maps to (1,1,1) exactly, as it must.
static const float3x3 Rec709_To_AWG4 = float3x3(
    float3(0.565837f, 0.340331f, 0.093832f),
    float3(0.088626f, 0.809347f, 0.102028f),
    float3(0.017750f, 0.109448f, 0.872802f)
);

// ARRI LogC4 curve constants (per ARRI LogC4 Specification, Section 4.1.1)
static const float LogC4_a = (262144.0 - 16.0) / 117.45;
static const float LogC4_b = (1023.0 - 95.0) / 1023.0;
static const float LogC4_c = 95.0 / 1023.0;
static const float LogC4_s = (7.0 * 0.6931471805599453 * exp2(7.0 - 14.0 * LogC4_c / LogC4_b)) / (LogC4_a * LogC4_b);
static const float LogC4_t = (exp2(14.0 * (-LogC4_c / LogC4_b) + 6.0) - 64.0) / LogC4_a;

// LogC4 signal value for a given linear scene value (log segment only).
// Valid for x > LogC4_t, which covers every landmark we use below.
#define LOGC4_OF(x) ((log2(LogC4_a * (x) + 64.0) - 6.0) / 14.0 * LogC4_b + LogC4_c)

float EncodeLogC4Scalar(float x)
{
    if (x < LogC4_t)
    {
        return (x - LogC4_t) / LogC4_s;
    }
    return LOGC4_OF(x);
}

float3 EncodeLogC4(float3 LinearScene)
{
    float3 LogC4;
    [unroll]
    for (int i = 0; i < 3; ++i)
    {
        LogC4[i] = EncodeLogC4Scalar(LinearScene[i]);
    }
    return LogC4;
}

// -----------------------------------------------------------------------
// ARRI-convention exposure false colour
// -----------------------------------------------------------------------
// Replaces the old continuous blue->cyan->green->yellow->red gradient.
// Two problems with the old version:
//   1. It banded on RAW BUFFER luminance, which includes UE's pre-exposure.
//      Pre-exposure auto-normalises the buffer toward mid-range every frame,
//      so the chart read "green-ish" regardless of actual scene exposure.
//      (This is why your box stayed green on an overexposed image.)
//   2. A continuous gradient has no crisp "correct" band, so it never tells
//      you which direction to move. ARRI monitors use DISCRETE bands.
//
// Bands follow the ARRI false colour convention, anchored to physical
// exposure landmarks on the LogC4 signal of true scene luminance:
//   RED     clipped (sensor saturation)             -> decrease exposure
//   YELLOW  within ~1 stop of clip                  -> decrease exposure
//   PINK    +1 stop over mid grey (avg. skin tone)
//   GREEN   18% mid grey, +/- 1/4 stop              -> exposure is correct
//   GREY    everything in the normal range (shown as the log signal itself,
//           so the image stays readable)
//   BLUE    4-6 stops under mid grey (deep shadow)  -> increase exposure
//   PURPLE  >= 6 stops under (noise floor / crush)  -> increase exposure
//
// LogC4 landmarks (for reference): mid grey 0.18 encodes to ~0.278,
// each stop in the log segment spans ~0.065 of signal.
static const float FC_GreyLo  = LOGC4_OF(0.18 * 0.84090);  // -1/4 stop, ~0.265
static const float FC_GreyHi  = LOGC4_OF(0.18 * 1.18921);  // +1/4 stop, ~0.293
static const float FC_SkinLo  = LOGC4_OF(0.36 * 0.84090);  // +3/4 stop, ~0.322
static const float FC_SkinHi  = LOGC4_OF(0.36 * 1.18921);  // +5/4 stop, ~0.352
static const float FC_BlueLo  = LOGC4_OF(0.18 / 64.0);     // -6 stops,  ~0.102
static const float FC_BlueHi  = LOGC4_OF(0.18 / 16.0);     // -4 stops,  ~0.124

float3 ExposureFalseColour(float TrueLuminance, float ClipLuminance)
{
    float S = EncodeLogC4Scalar(max(TrueLuminance, 0.0));

    // Clip landmarks track the simulated sensor: the low-gain path saturates
    // at FullWell / LowGainAmount in scene-linear units.
    float RedAt    = LOGC4_OF(ClipLuminance * 0.925); // ~1/9 stop below clip
    float YellowAt = LOGC4_OF(ClipLuminance * 0.5);   // 1 stop below clip

    if (S >= RedAt)                        return float3(1.00, 0.00, 0.00); // red
    if (S >= YellowAt)                     return float3(1.00, 0.85, 0.00); // yellow
    if (S >= FC_SkinLo && S <= FC_SkinHi)  return float3(1.00, 0.45, 0.75); // pink
    if (S >= FC_GreyLo && S <= FC_GreyHi)  return float3(0.00, 1.00, 0.00); // green
    if (S <  FC_BlueLo)                    return float3(0.55, 0.00, 0.85); // purple
    if (S <  FC_BlueHi)                    return float3(0.10, 0.25, 1.00); // blue

    // Normal range: show the log signal as greyscale so the frame is readable
    return saturate(S).xxx;
}

[numthreads(8, 8, 1)]
void DualGrainArchitectureCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (DispatchThreadId.x >= (uint) ViewSize.x || DispatchThreadId.y >= (uint) ViewSize.y)
        return;

    int3 Coord = int3(DispatchThreadId.xy, 0);
    float4 SceneColor = SceneColorTexture.Load(Coord);

    // -------------------------------------------------------------------
    // PRE-EXPOSURE FIX (this is the load-bearing change)
    // -------------------------------------------------------------------
    // UE stores SceneColor PRE-EXPOSED: buffer = true_linear * PreExposure,
    // where PreExposure is derived from the previous frame's auto exposure
    // to keep values inside FP16 range. Everything downstream of us divides
    // it back out.
    //
    // Every physically-anchored constant in this shader (0.18 mid grey,
    // thresholds, the LogC4 curve, false-colour landmarks) is defined in
    // TRUE scene-linear units. Operating on the pre-exposed buffer meant:
    //   - the blend band [ShadowThreshold, HighlightThreshold] landed at an
    //     arbitrary, auto-exposure-dependent place in the real scene
    //     (in your test EXR, PreExposure was ~1/12, which put the band
    //     right across the character's midtones), and
    //   - LogC4 encoded the wrong values, and
    //   - false colour was normalised toward "correct" every frame.
    //
    // So: divide PreExposure out on read, multiply it back in on write.
    // Whatever value V we want to survive to the display / EXR export must
    // be stored as V * PreExposure, because the rest of the chain will
    // divide by PreExposure.
    float3 LinearScene = SceneColor.rgb * View.OneOverPreExposure;

    // Optional test-exposure offset in stops. Use this (not the gain CVars)
    // when you want to push the image up or down while testing -- it is an
    // explicit exposure control and does not distort the DGA simulation.
    LinearScene *= exp2(ExposureOffset);

    // Rec.709 luminance of TRUE scene light
    float Luminance = dot(LinearScene, float3(0.2126, 0.7152, 0.0722));

    if (DiagLuminance != 0)
    {
        float ClipLuminance = FullWell / max(LowGainAmount, 1e-4);
        float3 FC = ExposureFalseColour(Luminance, ClipLuminance);
        // Re-apply PreExposure so the chart colours survive the downstream
        // divide. For exact colours, view with the tonemapper disabled
        // (ShowFlag.Tonemapper 0); through the filmic tonemapper the bands
        // stay identifiable but slightly desaturated.
        OutputTexture[DispatchThreadId.xy] = float4(FC * View.PreExposure, 1.0);
        return;
    }

    // -------------------------------------------------------------------
    // DUAL GAIN MERGE (radiometrically normalised -- the banding fix)
    // -------------------------------------------------------------------
    // The old merge blended (Scene * 4) with (Scene * 1) directly. That made
    // the transfer function NON-MONOTONIC through the blend band:
    //   f(L) = L * lerp(HighGain, LowGain, smoothstep(0.18, 0.5, L))
    //   f(0.18) = 0.72 but f(0.5) = 0.5
    // i.e. brighter scene areas rendered DARKER than dimmer ones inside the
    // band -- a tone reversal. That is exactly the harsh, gradient-free
    // light/shadow switching you saw around the character model.
    //
    // On the real ALEV4 sensor, both gain paths read the SAME exposure and
    // are normalised back to a common photometric scale before combination.
    // The merged image is radiometrically transparent; the paths differ only
    // in where they CLIP (and, on real hardware, in noise):
    //   - the high-gain read saturates the ADC earlier -> clips at
    //     FullWell / HighGain in scene units, but has cleaner shadows,
    //   - the low-gain read keeps highlights up to FullWell / LowGain.
    //
    // Each path below: amplify, clip at ADC full-scale, normalise back.
    float3 HighGainPath = min(LinearScene * HighGainAmount, FullWell) / HighGainAmount;
    float3 LowGainPath  = min(LinearScene * LowGainAmount,  FullWell) / LowGainAmount;

    // Luminance-weighted crossfade: high-gain data in shadows, low-gain in
    // highlights. Because both paths now agree below their clip points, the
    // seam is invisible -- the mask only decides WHICH path's clipping and
    // (future) noise characteristics a pixel inherits.
    float Mask = smoothstep(ShadowThreshold, HighlightThreshold, Luminance);

    // Safety: guarantee the crossfade has fully reached the low-gain path
    // well before the high-gain path saturates, whatever the user sets the
    // thresholds or gains to. Otherwise clipped high-gain data could leak
    // into the blend and flatten highlights.
    float HighClip = FullWell / max(HighGainAmount, 1e-4);
    Mask = max(Mask, smoothstep(0.25 * HighClip, 0.75 * HighClip, Luminance));

    float3 Merged = lerp(HighGainPath, LowGainPath, Mask);

    // Gamut transform: Rec.709 linear -> AWG4 linear
    float3 MergedAWG4 = mul(Rec709_To_AWG4, Merged);

    // LogC4 encode (or stay linear in AWG4 if disabled)
    float3 FinalRGB = (LogC4Enabled != 0) ? EncodeLogC4(MergedAWG4) : MergedAWG4;

    // Re-apply PreExposure on write (see note above). With this in place,
    // an EXR export of the buffer yields clean 0..1 LogC4 signal instead of
    // LogC4-times-arbitrary-constant.
    OutputTexture[DispatchThreadId.xy] = float4(FinalRGB * View.PreExposure, SceneColor.a);
}
